@model CustomerManagementWebApp.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<h1>Delete Order</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this order?
</div>

<dl class="row">

    <dt class="col-sm-2">
        Customer
    </dt>

    <dd class="col-sm-10">
        @Model.CustomerName
    </dd>

    <dt class="col-sm-2">
        Product
    </dt>

    <dd class="col-sm-10">
        @Model.Product
    </dd>

    <dt class="col-sm-2">
        Quantity
    </dt>

    <dd class="col-sm-10">
        @Model.Quantity
    </dd>

    <dt class="col-sm-2">
        Amount
    </dt>

    <dd class="col-sm-10">
        @Model.Amount.ToString("N2")
    </dd>

</dl>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="OrderId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>