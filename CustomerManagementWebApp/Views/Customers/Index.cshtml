@model List<CustomerManagementWebApp.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Customer
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.CustomerId</td>
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@customer.CustomerId">
                        Edit
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@customer.CustomerId">
                        Delete
                    </a>
                    |
                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-customerId="@customer.CustomerId">
                        Orders
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>