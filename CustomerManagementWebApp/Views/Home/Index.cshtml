@{
    ViewData["Title"] = "Home";
}

<div class="container">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4">Customer Order Management</h1>
        <p class="lead">
            A simple ASP.NET Core MVC application using ADO.NET and SQLite.
        </p>
    </div>

    <!-- About -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>About This Application</h3>
        </div>

        <div class="card-body">
            <p>
                This sample application demonstrates how to build a
                real-world CRUD application using:
            </p>

            <ul>
                <li>ASP.NET Core MVC</li>
                <li>C#</li>
                <li>ADO.NET</li>
                <li>SQLite Database</li>
                <li>Razor Views</li>
                <li>Data Annotations</li>
                <li>Parameterized SQL Queries</li>
            </ul>

            <p>
                The application manages <strong>Customers</strong> and
                their <strong>Orders</strong>.
            </p>
        </div>
    </div>

    <!-- Database Relationship -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Database Relationship</h3>
        </div>

        <div class="card-body">

            <div class="text-center mb-3">
                <strong>Customer</strong>
                <span class="mx-3">1 ───────── * </span>
                <strong>Orders</strong>
            </div>

            <p>
                One customer can have multiple orders.
                The <code>Orders.CustomerId</code> column is a foreign key
                referencing <code>Customers.CustomerId</code>.
            </p>

            <pre>
Customers
-----------
CustomerId (PK)
Name
Email
Phone

        1
        |
        | CustomerId
        |
        *
Orders
-----------
OrderId (PK)
CustomerId (FK)
OrderDate
Product
Quantity
Amount
            </pre>

        </div>
    </div>

    <!-- Technologies -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>ADO.NET Components Used</h3>
        </div>

        <div class="card-body">

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Component</th>
                        <th>Purpose</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td><code>SQLiteConnection</code></td>
                        <td>Opens a connection to the SQLite database.</td>
                    </tr>

                    <tr>
                        <td><code>SQLiteCommand</code></td>
                        <td>Executes SQL statements.</td>
                    </tr>

                    <tr>
                        <td><code>SQLiteDataAdapter</code></td>
                        <td>Retrieves query results into a DataTable.</td>
                    </tr>

                    <tr>
                        <td><code>SQLiteDataReader</code></td>
                        <td>Reads query results row by row.</td>
                    </tr>

                    <tr>
                        <td><code>SQLiteParameter</code></td>
                        <td>Creates parameterized SQL queries.</td>
                    </tr>

                    <tr>
                        <td><code>DataTable</code></td>
                        <td>Stores query results in memory.</td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>

    <h3>ADO.NET Database Provider Classes & Namespaces</h3>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Database</th>
                <th>Connection</th>
                <th>Command</th>
                <th>DataAdapter</th>
                <th>DataReader</th>
                <th>Parameter</th>
                <th>Namespace</th>
            </tr>
        </thead>

        <tbody>

            <!-- SQLite -->
            <tr>
                <td><strong>SQLite</strong></td>
                <td><code>SQLiteConnection</code></td>
                <td><code>SQLiteCommand</code></td>
                <td><code>SQLiteDataAdapter</code></td>
                <td><code>SQLiteDataReader</code></td>
                <td><code>SQLiteParameter</code></td>
                <td><code>System.Data.SQLite</code></td>
            </tr>

            <!-- SQL Server -->
            <tr>
                <td><strong>SQL Server</strong></td>
                <td><code>SqlConnection</code></td>
                <td><code>SqlCommand</code></td>
                <td><code>SqlDataAdapter</code></td>
                <td><code>SqlDataReader</code></td>
                <td><code>SqlParameter</code></td>
