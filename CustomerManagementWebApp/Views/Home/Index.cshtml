            </tr>

            <!-- PostgreSQL -->
            <tr>
                <td><strong>PostgreSQL</strong></td>
                <td><code>NpgsqlConnection</code></td>
                <td><code>NpgsqlCommand</code></td>
                <td><code>NpgsqlDataAdapter</code></td>
                <td><code>NpgsqlDataReader</code></td>
                <td><code>NpgsqlParameter</code></td>
                <td><code>Npgsql</code></td>
            </tr>

            <!-- Oracle -->
            <tr>
                <td><strong>Oracle</strong></td>
                <td><code>OracleConnection</code></td>
                <td><code>OracleCommand</code></td>
                <td><code>OracleDataAdapter</code></td>
                <td><code>OracleDataReader</code></td>
                <td><code>OracleParameter</code></td>
                <td><code>Oracle.ManagedDataAccess.Client</code></td>
            </tr>

        </tbody>
    </table>

    <!-- Installation -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Installation & Setup</h3>
        </div>

        <div class="card-body">

            <h5>1. Install .NET SDK</h5>

            <p>
                Install the required .NET SDK on your computer.
            </p>

            <pre>dotnet --version</pre>

            <p>
                Make sure the command displays a valid .NET SDK version.
            </p>


            <h5>2. Download / Clone the Project</h5>

            <p>
                Download the project or clone it from your source repository.
            </p>

            <pre>git clone &lt;repository-url&gt;</pre>


            <h5>3. Open the Project Folder</h5>

            <pre>cd CustomerOrderMvc</pre>


            <h5>4. Restore NuGet Packages</h5>

            <pre>dotnet restore</pre>


            <h5>5. Build the Application</h5>

            <pre>dotnet build</pre>


            <h5>6. Run the Application</h5>

            <pre>dotnet run</pre>

            <p>
                The application will display the local HTTP/HTTPS URL in
                the console.
            </p>

        </div>
    </div>

    <!-- Database -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Database Setup</h3>
        </div>

        <div class="card-body">

            <p>
                No separate database server is required.
                This application uses SQLite.
            </p>

            <p>
                When the application starts, it automatically:
            </p>

            <ol>
                <li>Creates the SQLite database.</li>
                <li>Creates the Customers table.</li>
                <li>Creates the Orders table.</li>
                <li>Creates the Customer → Orders relationship.</li>
                <li>Inserts sample customer and order data.</li>
            </ol>

            <p>
                The database file is:
            </p>

            <pre>Database/CustomerOrders.db</pre>

        </div>
    </div>

    <!-- Application Features -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Application Features</h3>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">
                    <h5>Customers</h5>

                    <ul>
                        <li>View customers</li>
                        <li>Add customer</li>
                        <li>Edit customer</li>
                        <li>Delete customer</li>
                        <li>View customer's orders</li>
                    </ul>

                    <a asp-controller="Customers"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Customers
                    </a>
                </div>

                <div class="col-md-6">
                    <h5>Orders</h5>

                    <ul>
                        <li>View orders</li>
                        <li>Add order</li>
                        <li>Edit order</li>
                        <li>Delete order</li>
                        <li>Filter orders by customer</li>
                    </ul>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Orders
                    </a>
                </div>

            </div>

        </div>
    </div>

